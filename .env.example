# =============================================================================
# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan pernah meng-commit file .env / .env.local (sudah di-gitignore).
# =============================================================================

# --- Supabase: Project Settings -> API -----------------------------------------
# URL dan anon/publishable key aman dipakai di browser karena dilindungi RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Rahasia server-side ------------------------------------------------------
# MELEWATI SELURUH RLS. Hanya untuk server (script seed/migrasi, operasi admin).
# Jangan beri prefix NEXT_PUBLIC_ dan jangan pernah dipakai di Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Situs --------------------------------------------------------------------
# Dipakai untuk metadata, canonical, sitemap, dan robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin auth (server-only) -------------------------------------------------
# Allowlist email admin yang boleh mengakses /admin, dipisahkan koma.
# Contoh: ADMIN_EMAILS=admin@contoh.com,pengurus@contoh.org
# KOSONGKAN (atau hapus) untuk menonaktifkan akses admin sepenuhnya (fail-closed).
# Jangan beri prefix NEXT_PUBLIC_ — nilai ini hanya dibaca di server.
ADMIN_EMAILS=
